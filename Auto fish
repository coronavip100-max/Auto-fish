local function IsFailureStatus(s)
    if type(s) ~= "string" then return false end
    local l = string.lower(s)
    return string.find(l, "fail") or string.find(l, "cancel") or string.find(l, "lost") or string.find(l, "error") or string.find(l, "escape")
end

local function IsToolValid(tool)
    if not tool then return false end
    local ln = string.lower(tool.Name)
    return (string.find(ln, "rod") or string.find(ln, "fishing")) and true or false
end

local function EquipRod()
    local char = localPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local eq = char:FindFirstChildOfClass("Tool")
    if eq and IsToolValid(eq) then return true end
    local bp = localPlayer:FindFirstChild("Backpack")
    if bp then
        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") and IsToolValid(tool) then
                local ok = pcall(function() hum:EquipTool(tool) end)
                if ok then task.wait(0.5); return true end
            end
        end
    end
    return false
end

local function ForceToolReset()
    local char = localPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    pcall(function() hum:UnequipTools() end)
    task.wait(CONFIG.TOOL_RESET_WAIT)
    return EquipRod()
end

