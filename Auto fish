    })
    t:Play()
end
local function HideWaitOverlay()
    waitVisGen = waitVisGen + 1
    local myGen = waitVisGen
    local t = TweenService:Create(WaitOverlay, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 240 * 0.85, 0, 150 * 0.85),
