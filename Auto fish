-- 🛒 دالة البيع السريعة (مع إمكانية الإيقاف)
-- ==========================================
SellAllBtn.MouseButton1Click:Connect(function()
    if isSelling then
        isSelling = false
        SellAllBtn.Text = "⏳ جاري الإيقاف..."
        SellAllBtn.BackgroundColor3 = THEME.DangerLt
        return
    end

    if not Remotes.InventoryAction then
        SetStatus("خطأ: لم يتم العثور على ريموت البيع", THEME.Danger)
        return
    end

    isSelling = true
    SellAllBtn.Text = "⏹️ إيقاف البيع"
    SellAllBtn.BackgroundColor3 = THEME.Danger
    SetStatus("جاري بيع جميع السمك بسرعة...", THEME.Warn)

    task.spawn(function()
        for loop = 1, 3 do
            if not isSelling then break end
            for i, fishName in ipairs(FISH_NAMES) do
                if not isSelling then break end
                pcall(function()
                    Remotes.InventoryAction:FireServer({
                        amount = 99,
                        action = "sell",
                        fishId = "Glaciers/" .. fishName
                    })
                end)
                task.wait(0.1) 
            end
        end

        if isSelling then
            SellAllBtn.Text = "✅ تم البيع بنجاح!"
            SellAllBtn.BackgroundColor3 = THEME.SuccessLt
            SetStatus("تم بيع جميع السمك!", THEME.Success)
            task.wait(2)
        end

        isSelling = false
        SellAllBtn.Text = "💰 بيع جميع السمك"
        SellAllBtn.BackgroundColor3 = THEME.Success
        if StatusLabel.Text == "جاري بيع جميع السمك بسرعة..." then
            SetStatus("جاهز", THEME.TextDim)
        end
    end)
end)

