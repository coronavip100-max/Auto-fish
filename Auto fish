local function RunOneAttempt(myLoopId)
    waitGeneration = waitGeneration + 1
    WaitOverlay.Visible = false
    local castStartVersion = statusVersion
    
    SetStatus("تجهيز...", THEME.TextDim)
    if not EquipRod() then return "equip_failed" end
    if not isRunning or autoFishLoopId ~= myLoopId then return "cancelled" end

    local char = localPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not IsToolValid(tool) then return "equip_failed" end

    pcall(function() tool:Deactivate() end)
    task.wait(0.3)
    SetStatus("رمي...", THEME.AccentGlow)
    pcall(function() tool:Activate() end)
    task.wait(CONFIG.CAST_DEACTIVATE_WAIT)
    pcall(function() if tool and tool.Parent then tool:Deactivate() end end)

    local castStart = tick()
    local castOk = false
    while isRunning and autoFishLoopId == myLoopId do
        if tick() - castStart > CONFIG.CAST_TIMEOUT then break end
        if statusVersion > castStartVersion then
            if LastStatus == "Searching" or LastStatus == "LongWaitStart" then castOk = true; break
            elseif IsFailureStatus(LastStatus) then break end
        end
        task.wait(0.1)
    end

    if not castOk then ForceToolReset(); return "cast_failed" end

    SetStatus("انتظار السمكة...", THEME.AccentGlow)
    local fishStartVersion = statusVersion
    local fishStart = tick()
    local success = false

    while isRunning and autoFishLoopId == myLoopId do
        if statusVersion > fishStartVersion then
            if LastStatus == "Caught" then success = true; break
            elseif IsFailureStatus(LastStatus) then break end
        end
        if tick() - fishStart > CONFIG.FISH_TIMEOUT then break end
        task.wait(0.2)
    end

    if success then
        SetStatus("تم الصيد!", THEME.Success)
        totalCaught = totalCaught + 1
        if StatCaught then StatCaught.Text = "الأسماك: " .. totalCaught end
        task.wait(CONFIG.POST_CATCH_DELAY)
        return "success"
    else
        return "failed"
    end
end

local function AutoFishLoop()
    autoFishLoopId = autoFishLoopId + 1
    local myLoopId = autoFishLoopId
    task.spawn(function()
        while isRunning and autoFishLoopId == myLoopId do
            local result = RunOneAttempt(myLoopId)
            if not (isRunning and autoFishLoopId == myLoopId) then break end
            if result ~= "success" then task.wait(1) end
        end
    end)
end

