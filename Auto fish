local function RunOneAttempt(myLoopId)
    currentAttemptId = currentAttemptId + 1
    attemptStartTick = tick()
    CancelWait()
    local castStartVersion = statusVersion

    SetStatus("تجهيز الصنارة...", THEME.AccentLite)
    if not EquipRod() then
        SetStatus("تعذّر تجهيز الصنارة", THEME.Danger)
        return "equip_failed"
    end
    if not isRunning or autoFishLoopId ~= myLoopId then return "cancelled" end

    local char = localPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not IsToolValid(tool) then SetStatus("تعذّر تجهيز الصنارة", THEME.Danger); return "equip_failed" end

    pcall(function() tool:Deactivate() end)
    task.wait(0.3)
    SetStatus("رمي الصنارة...", THEME.AccentLite)
    pcall(function() tool:Activate() end)
    task.wait(CONFIG.CAST_DEACTIVATE_WAIT)
    pcall(function() if tool and tool.Parent then tool:Deactivate() end end)

    local castStart = tick()
    local castOk, castFailReason, castFailStatus = false, nil, nil
    local toolLostAt = nil

    while isRunning and autoFishLoopId == myLoopId do
        local c = localPlayer.Character
        if not c then castFailReason = "character_lost"; break end
        if tick() - castStart > CONFIG.CAST_TIMEOUT then castFailReason = "cast_timeout"; break end
        local eq = c:FindFirstChildOfClass("Tool")
        if not eq then
            if not toolLostAt then toolLostAt = tick() end
            if tick() - toolLostAt > CONFIG.TOOL_LOST_GRACE then castFailReason = "tool_lost_during_cast"; break end
        else toolLostAt = nil end
        
        if statusVersion > castStartVersion then
            local curStatus = LastStatus
            castStartVersion = statusVersion
            if curStatus == "Searching" or curStatus == "LongWaitStart" then castOk = true; break
            elseif IsFailureStatus(curStatus) then castFailReason = "cast_status_fail"; castFailStatus = curStatus; break end
        end
        task.wait(0.1)
    end

    if not castOk then
        SetStatus(GetUserFailureMessage(castFailStatus, castFailReason), THEME.Danger)
        pcall(function() local c2 = localPlayer.Character; local t2 = c2 and c2:FindFirstChildOfClass("Tool"); if t2 then t2:Deactivate() end end)
        if not (isRunning and autoFishLoopId == myLoopId) then return "cancelled" end
        ForceToolReset()
        return "cast_failed"
    end

    SetStatus("في انتظار السمكة...", THEME.AccentLite)
    local fishStartVersion = statusVersion
    local fishStart = tick()
    local success, failReason = false, nil

    while isRunning and autoFishLoopId == myLoopId do
        local c = localPlayer.Character
        local eq = c and c:FindFirstChildOfClass("Tool")
        local bp = localPlayer:FindFirstChild("Backpack")
        local bpTool = bp and bp:FindFirstChildWhichIsA("Tool")
        if not eq and not bpTool then failReason = "tool_deleted"; break end
        
        if statusVersion > fishStartVersion then
            local curStatus = LastStatus
            fishStartVersion = statusVersion
            if curStatus == "Caught" then success = true; break
            elseif IsFailureStatus(curStatus) then failReason = "fish_status_fail:" .. tostring(curStatus); break end
        end
        if tick() - fishStart > CONFIG.FISH_TIMEOUT then failReason = "fish_timeout"; break end
        task.wait(0.2)
    end

    if success then
        SetStatus("تم الصيد بنجاح", THEME.Success)
        local waitUntil = tick() + CONFIG.MINIGAME_WAIT_GRACE
        while isRunning and autoFishLoopId == myLoopId and WaitOverlay.Visible and tick() < waitUntil do task.wait(0.2) end
        task.wait(CONFIG.POST_CATCH_DELAY)
        return "success"
    else
        SetStatus(GetUserFailureMessage(nil, failReason), THEME.Danger)
        if not (isRunning and autoFishLoopId == myLoopId) then return "cancelled" end
        return "failed"
    end
end

local function AutoFishLoop()
    autoFishLoopId = autoFishLoopId + 1
    local myLoopId = autoFishLoopId
    task.spawn(function()
        while isRunning and autoFishLoopId == myLoopId do
            local result = "failed"
            local ok, err = pcall(function() result = RunOneAttempt(myLoopId) or "failed" end)
            if not ok then result = "error"; SetStatus("حدث خطأ", THEME.Danger) end
            if not (isRunning and autoFishLoopId == myLoopId) then break end
            attemptStartTick = 0
            if result == "cancelled" then break
            elseif result ~= "success" then task.wait(1) end
        end
    end)
end

