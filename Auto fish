local function ToggleMainUI()
    Main.Visible = not Main.Visible
    if Main.Visible then
        -- إرجاع الحجم الصحيح سواء كان مصغر أو لا
        local targetHeight = isMinimized and MAIN_MIN_HEIGHT or MAIN_HEIGHT
        Main.Size = UDim2.new(0, MAIN_WIDTH * 0.8, 0, targetHeight * 0.8)
        TweenService:Create(Main, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, MAIN_WIDTH, 0, targetHeight)}):Play()
        
        -- التأكد من ظهور التبويبات لو كان مصغر
        if not isMinimized then
            TabBar.Visible = true
            ContentArea.Visible = true
        end
    end
end

HideBtn.MouseButton1Click:Connect(ToggleMainUI)

-- 🟢 كود السحب (Drag System) للزر العائم
local draggingFAB = false
local dragStartFAB = nil
local startPosFAB = nil
local hasDraggedFAB = false
local dragThreshold = 10

FloatBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingFAB = true
        hasDraggedFAB = false
        dragStartFAB = input.Position
        startPosFAB = FloatBtn.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if draggingFAB and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStartFAB
        if not hasDraggedFAB and (math.abs(delta.X) > dragThreshold or math.abs(delta.Y) > dragThreshold) then
            hasDraggedFAB = true
        end
        if hasDraggedFAB then
            FloatBtn.Position = UDim2.new(
                startPosFAB.X.Scale, startPosFAB.X.Offset + delta.X, 
                startPosFAB.Y.Scale, startPosFAB.Y.Offset + delta.Y
            )
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if draggingFAB then
            draggingFAB = false
            if not hasDraggedFAB then
                ToggleMainUI()
            end
        end
    end
end)

