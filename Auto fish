function UpdateMainHeight()
    if isMinimized then return end
    local target = GetTargetHeight()
    TweenService:Create(Main, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, MAIN_WIDTH, 0, target)
    }):Play()
end

SettingsBtn.MouseButton1Click:Connect(function()
    local wasOpen = SettingsPanel.Visible
    SettingsPanel.Visible = not wasOpen
    InfoPanel.Visible = false
    UpdateMainHeight()
end)
InfoBtn.MouseButton1Click:Connect(function()
    local wasOpen = InfoPanel.Visible
    InfoPanel.Visible = not wasOpen
    SettingsPanel.Visible = false
    UpdateMainHeight()
end)
SPClose.MouseButton1Click:Connect(function() SettingsPanel.Visible = false; UpdateMainHeight() end)
IPClose.MouseButton1Click:Connect(function() InfoPanel.Visible = false; UpdateMainHeight() end)

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
    local pos = input.Position
    local function isInside(g)
        if not g or not g.Visible then return false end
        local a, s = g.AbsolutePosition, g.AbsoluteSize
        return pos.X >= a.X and pos.X <= a.X + s.X and pos.Y >= a.Y and pos.Y <= a.Y + s.Y
    end
    local changed = false
    if SettingsPanel.Visible and not isInside(SettingsPanel) and not isInside(SettingsBtn) then SettingsPanel.Visible = false; changed = true end
    if InfoPanel.Visible and not isInside(InfoPanel) and not isInside(InfoBtn) then InfoPanel.Visible = false; changed = true end
    if changed then UpdateMainHeight() end
end)

