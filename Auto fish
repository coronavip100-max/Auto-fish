local function SwitchTab(tabName)
    for name, data in pairs(Tabs) do
        if name == tabName then
            TweenService:Create(data.Btn, TweenInfo.new(0.2), {BackgroundTransparency = 0, BackgroundColor3 = THEME.Accent}):Play()
            data.Btn.TextColor3 = Color3.new(1,1,1)
            data.Stroke.Transparency = 0
            data.Stroke.Color = THEME.AccentGlow
        else
            TweenService:Create(data.Btn, TweenInfo.new(0.2), {BackgroundTransparency = 0.5, BackgroundColor3 = THEME.BgSoft}):Play()
            data.Btn.TextColor3 = THEME.TextDim
            data.Stroke.Transparency = 1
        end
    end
    
    for name, frame in pairs(ContentFrames) do
        if name == tabName then
            frame.Visible = true
            frame.Position = UDim2.new(0, 0, 0, 5)
            TweenService:Create(frame, TweenInfo.new(0.2), {Position = UDim2.new(0, 0, 0, 0)}):Play()
        else
            frame.Visible = false
        end
    end
    CurrentTab = tabName
end

