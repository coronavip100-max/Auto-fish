local waitVisGen = 0
local function ShowWaitOverlay()
    waitVisGen = waitVisGen + 1
    WaitOverlay.Visible = true
    WaitOverlay.Size = UDim2.new(0, 240 * 0.85, 0, 150 * 0.85)
    WaitOverlay.Position = UDim2.new(0.5, -240 * 0.425, 0.5, -150 * 0.425)
