local function EquipRod()
    local char = localPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end

    local equipped = char:FindFirstChildOfClass("Tool")
    if equipped and (string.find(string.lower(equipped.Name), "rod") or string.find(string.lower(equipped.Name), "fishing")) then
        return true 
    end

    local backpack = localPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and (string.find(string.lower(tool.Name), "rod") or string.find(string.lower(tool.Name), "fishing")) then
                hum:EquipTool(tool)
                task.wait(0.5) 
                return true
            end
        end
    end
    return false
end

local function AutoFishLoop()
    task.spawn(function()
        while isRunning do
            StatusLabel.Text = "الحالة: جاري مسك الصنارة..."
            StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
            
            if not EquipRod() then
                task.wait(2)
                continue
            end

            local char = localPlayer.Character
            local tool = char and char:FindFirstChildOfClass("Tool")
            if tool then
                pcall(function() tool:Deactivate() end)
            end
            task.wait(0.5)

            if tool then
                StatusLabel.Text = "الحالة: جاري الرمي..."
                pcall(function() tool:Activate() end)
                task.wait(1.2) 
                pcall(function() tool:Deactivate() end)
            end

            local timer = 0
            local castSuccess = false
            while isRunning and timer < 3 do
                if LastStatus == "Searching" or LastStatus == "LongWaitStart" then
                    castSuccess = true
                    break
                elseif LastStatus == "CastFailed" then
                    break
                end
                
                if not char:FindFirstChildOfClass("Tool") then break end
                task.wait(0.2)
                timer = timer + 0.2
            end
            
            if not castSuccess then
                StatusLabel.Text = "الحالة: فشل الرمي، إعادة..."
                StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                task.wait(1)
                continue
            end

            StatusLabel.Text = "الحالة: في انتظار السمكة..."
            StatusLabel.TextColor3 = Color3.fromRGB(100, 200, 255)
            
            timer = 0
            -- ننتظر لحد ما تصير الحالة Caught (الخيط الثاني هو اللي يرسل Complete)
            while isRunning and LastStatus ~= "Caught" and timer < 120 do
                if not char:FindFirstChildOfClass("Tool") then break end
                task.wait(0.5)
                timer = timer + 0.5
            end

            if LastStatus == "Caught" then
                StatusLabel.Text = "الحالة: ✅ تم الصيد بنجاح!"
                StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 100)
            end

            task.wait(3)
        end
    end)
end

