local visBusy = false
local function AnimateShow()
    visBusy = true
    Main.Visible = true
    local targetH = isMinimized and MAIN_MIN_HEIGHT or MAIN_FULL_HEIGHT
    Main.Size = UDim2.new(0, MAIN_WIDTH * 0.85, 0, targetH * 0.85)
    local t = TweenService:Create(Main, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, MAIN_WIDTH, 0, targetH)
    })
    t:Play()
    t.Completed:Wait()
    visBusy = false
end
local function AnimateHide()
    visBusy = true
    local curH = isMinimized and MAIN_MIN_HEIGHT or MAIN_FULL_HEIGHT
    local t = TweenService:Create(Main, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, MAIN_WIDTH * 0.85, 0, curH * 0.85)
    })
    t:Play()
    t.Completed:Wait()
    Main.Visible = false
    Main.Size = UDim2.new(0, MAIN_WIDTH, 0, curH)
    visBusy = false
end

