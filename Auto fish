local function GetUserFailureMessage(status, reason)
    local r = (type(reason) == "string") and reason or ""
    local s = (type(status) == "string") and status or ""

    if r == "equip_failed" then return "تعذّر تجهيز الصنارة" end
    if r == "cast_timeout" then return "انتهت مهلة الرمي — إعادة المحاولة" end
    if r == "tool_lost_during_cast" then return "فُقدت الصنارة — إعادة المحاولة" end
    if r == "character_lost" then return "تعذّر الوصول للشخصية — إعادة المحاولة" end
    if r == "fish_timeout" then return "انتهت المهلة — إعادة المحاولة" end
    if r == "tool_deleted" then return "فُقدت الصنارة — إعادة المحاولة" end
    if r ~= "" and string.find(r, "fish_status_fail", 1, true) then
        return "فشل الصيد — إعادة المحاولة"
    end
    if r == "cast_status_fail" or s == "CastFailed" then
        return "فشل الرمي — إعادة المحاولة"
    end

    local hay = r .. " " .. s
    if string.find(hay, "CastFailed", 1, true) then return "فشل الرمي — إعادة المحاولة" end
    if string.find(hay, "timeout", 1, true) or string.find(hay, "Timeout", 1, true) then
        return "انتهت المهلة — إعادة المحاولة"
    end
    if string.find(hay, "lost", 1, true) or string.find(hay, "Lost", 1, true) then
        return "فُقدت الصنارة — إعادة المحاولة"
    end
    return "حدث خطأ — إعادة المحاولة"
end

