    })
    t:Play()
    t.Completed:Connect(function()
        if waitVisGen == myGen then
            WaitOverlay.Visible = false
            WaitOverlay.Size = UDim2.new(0, 240, 0, 150)
            WaitOverlay.Position = UDim2.new(0.5, -120, 0.5, -75)
        end
    end)
end

-- ==========================================
-- Minigame + GUID
-- ==========================================
local waitGeneration = 0
local processedGuids = {}
local processedQueue = {}

local function MarkGuidProcessed(guid)
    if processedGuids[guid] then return end
    processedGuids[guid] = true
    table.insert(processedQueue, guid)
    if #processedQueue > 20 then
        local old = table.remove(processedQueue, 1)
        processedGuids[old] = nil
    end
end

local function CancelWait()
    waitGeneration = waitGeneration + 1
    HideWaitOverlay()
    CurrentGUID = nil
end

local function ShowWaitAndComplete(guid)
    local myGuid = tostring(guid)
    if processedGuids[myGuid] then return end
    local myGen = waitGeneration + 1
    waitGeneration = myGen
    CurrentGUID = myGuid
    ShowWaitOverlay()
    WaitTitle.Text = "⏳  انتظر 4 ثوانٍ"
    WaitCount.Text = "4"
    WaitSub.Text = "جارٍ تجهيز اللعبة..."
    SetStatus("لعبة صيد — انتظار...", THEME.Warn)
    Diag("Minigame Start GUID=" .. myGuid)
    task.spawn(function()
        for i = 4, 1, -1 do
            if waitGeneration ~= myGen or not isRunning then
                if waitGeneration == myGen then HideWaitOverlay() end
                return
            end
            WaitCount.Text = tostring(i)
            task.wait(1)
        end
        if waitGeneration ~= myGen or not isRunning then
            if waitGeneration == myGen then HideWaitOverlay() end
            return
        end
        SetStatus("إنهاء اللعبة المصغرة...", THEME.AccentLite)
        local ok = pcall(function()
            Remotes.MinigameAction:FireServer("Complete", myGuid)
        end)
        Diag("Complete sent for GUID=" .. myGuid .. " ok=" .. tostring(ok))
        if ok then MarkGuidProcessed(myGuid) end
        if waitGeneration == myGen then HideWaitOverlay() end
    end)
end

if Remotes.MinigameCommand then
    Remotes.MinigameCommand.OnClientEvent:Connect(function(cmd, guid)
        if cmd == "Start" and guid and isRunning then
            local g = tostring(guid)
            if (WaitOverlay.Visible and CurrentGUID == g) or processedGuids[g] then return end
            ShowWaitAndComplete(g)
        end
    end)
end

